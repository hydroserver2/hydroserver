# Deployment Settings

PROXY_BASE_URL =             # The base URL HydroServer will be served from.
ALLOWED_HOSTS =              # Defaults to the host of PROXY_BASE_URL.
DEBUG =                      # True/False: This should be set to False in production environments.
STRICT_SECURITY =            # True/False: Enables CSRF protection, requires a real SECRET_KEY, applies default account rate limits, requires IDP_OIDC_PRIVATE_KEY when OIDC is enabled, and (unless CORS_ALLOW_CREDENTIALS is set explicitly) determines whether cross-origin requests may include credentials. Defaults to False for local environments.
SAME_ORIGIN_FRONTEND =       # True/False: Set when the frontend is served from the same origin as the backend rather than a separate local dev server. Defaults to False.
CORS_ALLOW_CREDENTIALS =     # True/False: Whether cross-origin requests may include credentials (cookies). Defaults to the opposite of STRICT_SECURITY — only needs to be set explicitly if you're running a split-origin frontend/backend deployment.
LOG_FORMAT =                 # 'standard' or 'json'. Defaults to 'standard'.
CSRF_TRUSTED_ORIGINS =       # Comma-separated origins trusted for session-cookie-authenticated requests. Defaults to PROXY_BASE_URL; only needed if your frontend isn't same-origin with the API.
SECRET_KEY =                 # This is required by Django. Keep this value secret.
WEB_CLIENT_URL =             # The base URL of the frontend app; used to redirect users after login/logout. Defaults to PROXY_BASE_URL if SAME_ORIGIN_FRONTEND, otherwise http://127.0.0.1:1203.


# Account Settings

SMTP_URL =                  # A connection to the SMTP server Django will send account related emails from.
DEFAULT_FROM_EMAIL =        # The email address Django will send account related emails from.
ACCOUNT_SIGNUP_ENABLED =    # True/False: Controls whether new users can create their own accounts.
ACCOUNT_OWNERSHIP_ENABLED = # True/False: Controls whether new users can create/own workspaces.
SOCIALACCOUNT_SIGNUP_ONLY = # True/False: Controls whether non-social account creation is supported.
ACCOUNT_RATE_LIMITS =       # false to disable rate limiting on account views entirely, or a JSON object overriding specific limits (e.g. {"login": "5/m/ip"}) on top of allauth's defaults. Defaults to {} (allauth's defaults) outside TRUSTED_LOCAL_ENVIRONMENT, false within it.


# OpenID Connect Identity Provider Settings

IDP_OIDC_ENABLED =                  # True/False: Controls whether the OIDC identity provider is enabled. Defaults to True.
IDP_OIDC_PRIVATE_KEY =              # The RSA private key (PEM, raw string) used to sign OIDC tokens. Required for deployed instances with IDP_OIDC_ENABLED. In local development, falls back to reading django/dev_oidc_private_key.pem if present, otherwise unset.
IDP_OIDC_PRIVATE_KEY_FILE =         # Path to a file containing the RSA private key (PEM) used to sign OIDC tokens. Alternative to IDP_OIDC_PRIVATE_KEY; takes precedence if both are set.
IDP_OIDC_ACCESS_TOKEN_EXPIRES_IN =  # Lifetime of OIDC access tokens, in seconds. Defaults to 3600 (1 hour).
IDP_OIDC_ROTATE_REFRESH_TOKEN =     # True/False: Controls whether OIDC refresh tokens rotate on use. Defaults to True.


# Database Settings

DATABASE_URL =       # A connection to the PostgreSQL server HydroServer will use.
CONN_MAX_AGE =       # Controls how long Django will hold database connections open before closing them.
CONN_HEALTH_CHECKS = # True/False: Controls whether connection health checks are enabled.
SSL_REQUIRED =       # True/False: Controls whether Django will connect to the database using SSL.


# Storage Settings

MEDIA_STORAGE_BACKEND =  # Dotted path to the Django storage backend for file attachments. Defaults to local filesystem storage. Use storages.backends.s3.S3Storage or storages.backends.gcloud.GoogleCloudStorage for cloud deployments.
MEDIA_STORAGE_OPTIONS =  # JSON object of kwargs passed to MEDIA_STORAGE_BACKEND. Defaults to a local "media" directory. For S3/GCS use e.g. {"bucket_name": "...", "location": "media"}.
STATIC_STORAGE_BACKEND = # Dotted path to the Django storage backend for static files. Defaults to local filesystem storage. Use storages.backends.s3.S3Storage or storages.backends.gcloud.GoogleCloudStorage for cloud deployments.
STATIC_STORAGE_OPTIONS = # JSON object of kwargs passed to STATIC_STORAGE_BACKEND. Defaults to a local "static" directory. For S3/GCS use e.g. {"bucket_name": "...", "location": "static"}.
STATIC_HOST =            # Optional absolute origin prefixed onto STATIC_URL (e.g. a CloudFront domain) to front WhiteNoise-served static files with a CDN. Only applies when static storage is local. Leave unset to serve static files at a relative /static/ path.
WHITENOISE_MAX_AGE =     # Cache-Control max-age (seconds) WhiteNoise sets on locally-served static files. Defaults to 86400 (1 day).


# Celery Settings

TASK_RUN_CLEANUP_CRONTAB = # Cron schedule ("minute hour day-of-month month day-of-week") for the daily task-run cleanup job. Defaults to "0 3 * * *" (3:00 AM).
TASK_RUN_RETENTION_DAYS =  # Number of days of task run history to keep before cleanup deletes it. Defaults to 7.


# SensorThings Settings

SENSORTHINGS_V1_1_MAX_TOP = # Maximum page size ($top) allowed for SensorThings API queries. Defaults to 1000.
