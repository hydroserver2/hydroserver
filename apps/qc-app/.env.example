# Backend the dev server proxies /api to (e.g. a HydroServer instance).
VITE_APP_PROXY_BASE_URL=

# Origin of the data-management app, which owns login/auth. In dev the two
# apps run on separate ports, so point this at data-management (e.g.
# http://127.0.0.1:1203). Leave unset in production, where the QC app is
# served by data-management under the same origin and /login resolves there.
VITE_APP_DATA_MANAGEMENT_URL=

# Set to 1 to drop COOP/COEP headers when talking to a backend that doesn't
# serve Cross-Origin-Resource-Policy. Disables SharedArrayBuffer-backed
# workers (they fall back to inline execution).
VITE_APP_DISABLE_COOP=
