#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_DIR="$ROOT_DIR/django"

export PROXY_BASE_URL="${PROXY_BASE_URL:-http://localhost}"
export WEB_CLIENT_URL="${WEB_CLIENT_URL:-http://localhost}"
export SMTP_URL="${SMTP_URL:-smtp://127.0.0.1:1025}"
export ALLOWED_HOSTS="${ALLOWED_HOSTS:-127.0.0.1,localhost,host.docker.internal}"

if [[ -n "${PYTHON_BIN:-}" ]]; then
  PYTHON_BIN="$PYTHON_BIN"
elif [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
else
  PYTHON_BIN="python3.14"
fi

cd "$API_DIR"

if [[ "${1:-}" == "manage.py" ]]; then
  shift
  exec "$PYTHON_BIN" manage.py "$@"
fi

exec "$PYTHON_BIN" "$@"
