{
  "name": "@hydroserver/client",
  "version": "1.0.1",
  "description": "HydroServer TypeScript client",
  "type": "module",
  "main": "dist/@hydroserver-client.umd.cjs",
  "module": "dist/@hydroserver-client.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/@hydroserver-client.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/@hydroserver-client.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && rollup --config rollup.config.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage --environment jsdom",
    "gen:schemas": "DEBUG=True DEPLOYMENT_BACKEND=dev PROXY_BASE_URL=http://127.0.0.1:8000 python3.11 ../../django/manage.py export_openapi_contracts",
    "gen:data-types": "npx --yes openapi-typescript@7.13.0 ../../django/contracts/openapi/data.openapi.json --output ./src/generated/data.types.d.ts",
    "gen:auth-types": "npx --yes openapi-typescript@7.13.0 ../../django/contracts/openapi/auth.openapi.json --output ./src/generated/auth.types.d.ts",
    "gen:types": "npm run gen:data-types && npm run gen:auth-types",
    "gen:data-contracts": "tsx ./scripts/generate-contracts.data.ts",
    "gen:auth-contracts": "tsx ./scripts/generate-contracts.auth.ts",
    "gen:contracts": "npm run gen:data-contracts && npm run gen:auth-contracts",
    "gen": "npm run gen:schemas && npm run gen:types && npm run gen:contracts",
    "check:contract": "npm run gen && git diff --exit-code -- ../../django/contracts/openapi ./src/generated",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydroserver2/hydroserver.git",
    "directory": "packages/hydroserver-ts"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^22.1.0",
    "openapi-zod-client": "^1.18.3",
    "p-limit": "^6.2.0",
    "rollup": "^4.61.0",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
